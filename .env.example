# 复制为 .env 后按需修改。所有项都可用同名环境变量覆盖。

# ── 数据库 ──────────────────────────────────────────────────
GATEWAY_DATABASE_URL=mysql+aiomysql://root:root@127.0.0.1:3306/mcp_gateway?charset=utf8mb4

# ── MCP 端点 ────────────────────────────────────────────────
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8800
GATEWAY_MCP_PATH=/mcp

# ── 管理控制台 ──────────────────────────────────────────────
GATEWAY_ADMIN_USERNAME=admin
GATEWAY_ADMIN_PASSWORD=admin_best

# ── 密钥：生产环境必须覆盖！更换后已加密的上游凭证将无法解密 ──
GATEWAY_SECRET_KEY=dev-only-change-me

# 本机开发放行上面的公开默认值。对外可达的部署必须删除这一行（或改为 false），
# 并覆盖 GATEWAY_SECRET_KEY 与 GATEWAY_ADMIN_PASSWORD，否则进程会拒绝启动。
# 生成随机值：python -c "import secrets; print(secrets.token_urlsafe(48))"
GATEWAY_ALLOW_INSECURE_DEFAULTS=true

# ── 缓存与后台循环（秒）─────────────────────────────────────
GATEWAY_POLICY_CACHE_TTL=30
GATEWAY_REVISION_POLL_INTERVAL=1.0
GATEWAY_HEALTH_INTERVAL=30
GATEWAY_HEALTH_TIMEOUT=5
GATEWAY_HEALTH_FAILURE_THRESHOLD=2
GATEWAY_REVISION_CACHE_TTL=1.0

# ── 上游调用 ────────────────────────────────────────────────
GATEWAY_UPSTREAM_TIMEOUT=30
GATEWAY_DISCOVERY_TIMEOUT=15